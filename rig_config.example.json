{
  "version": "1.0",
  "rigName": "Main Live Rig",
  "keyboards": [
    { "id": "kbd1", "label": "KBD 1", "bankSize": 8, "buttonCount": 16, "faderCount": 8 },
    { "id": "kbd2", "label": "KBD 2", "bankSize": 8, "buttonCount": 16, "faderCount": 8 },
    { "id": "kbd3", "label": "KBD 3", "bankSize": 8, "buttonCount": 16, "faderCount": 8 },
    { "id": "kbd4", "label": "KBD 4", "bankSize": 8, "buttonCount": 16, "faderCount": 8 }
  ],
  "patches": {
    "maxPatches": 8,
    "restoreAnimation": {
      "durationMs": 500,
      "easing": "ease-out-cubic",
      "stepIntervalMs": 20,
      "stepCount": 25
    },
    "captureScope": ["kbd1", "kbd2", "kbd3", "kbd4"]
  },
  "stems": [
    { "id": "stem1", "label": "Drums", "trackName": "Drums" },
    { "id": "stem2", "label": "Bass", "trackName": "Bass" },
    { "id": "stem3", "label": "Keys", "trackName": "Keys" },
    { "id": "stem4", "label": "Vox", "trackName": "Vox" }
  ],
  "listeners": {
    "useSchedulePollForSongTime": true,
    "songTimePollHz": 10,
    "wrapListenersInTryExcept": true
  }
}
